# Copy to .env (gitignored) and fill in what your run needs. `agent-eval run`
# reads this file, then the environment. Values here are placeholders.

# Model: Sumopod, the provider the published runs used...
SUMOPOD_AI_API_KEY=your-sumopod-key
SUMOPOD_BASE_URL=https://your-sumopod-endpoint/v1
# ...or your own provider's key, with --model openai/gpt-5-mini.
# OPENAI_API_KEY=your-openai-key

# Target: only the one you run against. The filesystem suites need none,
# and mcp-backbone-local reads its key from the running container.
MCP_BACKBONE_EVAL_KEY=your-mcp-backbone-key
# MCP_GATEWAY_KEY=your-mcp-gateway-key

# Optional: send one trace per trial to an OpenTelemetry viewer.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
